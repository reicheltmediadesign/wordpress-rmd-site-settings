# German translation of RMD Site Settings (formal "Sie").
msgid ""
msgstr ""
"Project-Id-Version: RMD Site Settings 0.6.1\n"
"Report-Msgid-Bugs-To: https://github.com/reicheltmediadesign/wordpress-rmd-site-settings/issues\n"
"Language: de_DE\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: rmd-site-settings\n"

msgid "Basic site settings in one place: disable comments globally or per post type, switch off XML-RPC, clean up wp_head and tidy the dashboard."
msgstr "Basis-Einstellungen an einer Stelle: Kommentare global oder pro Inhaltstyp deaktivieren, XML-RPC abschalten, wp_head aufräumen und das Dashboard entschlacken."

msgid "RMD Site Settings requires PHP %1$s or newer. This site runs PHP %2$s, so the plugin stays inactive."
msgstr "RMD Site Settings benötigt PHP %1$s oder neuer. Diese Website läuft mit PHP %2$s, daher bleibt das Plugin inaktiv."

msgid "Site settings"
msgstr "Website-Einstellungen"

msgid "Settings"
msgstr "Einstellungen"

msgid "Delete these comments permanently? This cannot be undone."
msgstr "Diese Kommentare endgültig löschen? Das lässt sich nicht rückgängig machen."

msgid "Comments"
msgstr "Kommentare"

msgid "XML-RPC"
msgstr "XML-RPC"

msgid "Page head"
msgstr "Seitenkopf"

msgid "Admin area"
msgstr "Adminbereich"

msgid "You are not allowed to access this page."
msgstr "Sie dürfen diese Seite nicht aufrufen."

msgid "%s comment deleted."
msgid_plural "%s comments deleted."
msgstr[0] "%s Kommentar gelöscht."
msgstr[1] "%s Kommentare gelöscht."

msgid "Nothing was deleted: choose what to delete."
msgstr "Nichts gelöscht: Bitte wählen Sie aus, was gelöscht werden soll."

msgid "Nothing was deleted: please confirm that the comments will be deleted permanently."
msgstr "Nichts gelöscht: Bitte bestätigen Sie, dass die Kommentare endgültig gelöscht werden."

msgid "Enabled (WordPress default)"
msgstr "Aktiviert (WordPress-Standard)"

msgid "Disabled everywhere"
msgstr "Überall deaktiviert"

msgid "Also removes the Comments menu, the discussion settings, comment feeds, the comments REST endpoint and comment blocks."
msgstr "Entfernt auch das Menü „Kommentare“, die Diskussions-Einstellungen, Kommentar-Feeds, den REST-Endpunkt für Kommentare und die Kommentar-Blöcke."

msgid "Disabled for selected post types"
msgstr "Für ausgewählte Inhaltstypen deaktiviert"

msgid "Post types"
msgstr "Inhaltstypen"

msgid "Existing comments"
msgstr "Bestehende Kommentare"

msgid "Keep showing existing comments"
msgstr "Bestehende Kommentare weiter anzeigen"

msgid "New comments are not possible, but approved comments stay visible and can still be moderated."
msgstr "Neue Kommentare sind nicht möglich, freigegebene Kommentare bleiben aber sichtbar und lassen sich weiter moderieren."

msgid "Disable XML-RPC"
msgstr "XML-RPC deaktivieren"

msgid "xmlrpc.php answers no requests, pingbacks are off and the RSD link is removed. Leave this off if you use the Jetpack plugin or an app that publishes via XML-RPC."
msgstr "xmlrpc.php beantwortet keine Anfragen mehr, Pingbacks sind aus und der RSD-Link wird entfernt. Lassen Sie diese Option aus, wenn Sie Jetpack oder eine App nutzen, die über XML-RPC veröffentlicht."

msgid "Emoji script"
msgstr "Emoji-Skript"

msgid "Browsers show emoji natively; removes the detection script, its styles and the DNS prefetch to s.w.org."
msgstr "Browser stellen Emojis selbst dar; entfernt das Erkennungsskript, seine Styles und den DNS-Prefetch zu s.w.org."

msgid "Generator tag"
msgstr "Generator-Tag"

msgid "Hides the WordPress version in the page source and feeds."
msgstr "Blendet die WordPress-Version im Quelltext und in Feeds aus."

msgid "Shortlink"
msgstr "Kurzlink"

msgid "Removes the ?p= shortlink from the page head and the HTTP headers."
msgstr "Entfernt den ?p=-Kurzlink aus dem Seitenkopf und den HTTP-Headern."

msgid "oEmbed discovery links"
msgstr "oEmbed-Discovery-Links"

msgid "Other sites can still embed your posts by URL."
msgstr "Andere Websites können Ihre Beiträge weiterhin per URL einbetten."

msgid "REST API link"
msgstr "REST-API-Link"

msgid "Removes the link to the REST API from the page head and the HTTP headers. The REST API itself keeps working."
msgstr "Entfernt den Link zur REST-API aus dem Seitenkopf und den HTTP-Headern. Die REST-API selbst funktioniert weiter."

msgid "RSD link"
msgstr "RSD-Link"

msgid "Only used by XML-RPC clients."
msgstr "Wird nur von XML-RPC-Clients genutzt."

msgid "Remove"
msgstr "Entfernen"

msgid "Welcome panel"
msgstr "Willkommensbereich"

msgid "Hide the welcome panel on the dashboard"
msgstr "Willkommensbereich im Dashboard ausblenden"

msgid "Events and news"
msgstr "Veranstaltungen und Neuigkeiten"

msgid "Hide the \"WordPress Events and News\" widget"
msgstr "Widget „WordPress-Veranstaltungen und Neuigkeiten“ ausblenden"

msgid "Quick draft"
msgstr "Schneller Entwurf"

msgid "Hide the \"Quick Draft\" widget"
msgstr "Widget „Schneller Entwurf“ ausblenden"

msgid "Footer text"
msgstr "Fußzeilentext"

msgid "Replaces \"Thank you for creating with WordPress\" at the bottom of every admin page. Allowed HTML: a, strong, em. Leave empty for the default text."
msgstr "Ersetzt den Text „Danke für … Vertrauen in WordPress.“ unten auf jeder Admin-Seite. Erlaubtes HTML: a, strong, em. Leer lassen für den Standardtext."

msgid "Delete comments"
msgstr "Kommentare löschen"

msgid "Deletes existing comments, trackbacks and pingbacks permanently from the database. Notes in the block editor are kept. Make a backup first."
msgstr "Löscht bestehende Kommentare, Trackbacks und Pingbacks endgültig aus der Datenbank. Notizen im Block-Editor bleiben erhalten. Legen Sie vorher ein Backup an."

msgid "There are no comments."
msgstr "Es gibt keine Kommentare."

msgid "What to delete"
msgstr "Was löschen"

msgid "All comments"
msgstr "Alle Kommentare"

msgid "Comments on selected post types"
msgstr "Kommentare zu ausgewählten Inhaltstypen"

msgid "Spam only"
msgstr "Nur Spam"

msgid "Confirmation"
msgstr "Bestätigung"

msgid "I understand that the comments are deleted permanently."
msgstr "Mir ist klar, dass die Kommentare endgültig gelöscht werden."

msgid "Comments are disabled on this site."
msgstr "Kommentare sind auf dieser Website deaktiviert."

msgid "Comments are disabled for: %s. Settings on this page do not apply to them."
msgstr "Kommentare sind deaktiviert für: %s. Die Einstellungen auf dieser Seite gelten dafür nicht."

msgid "Change in Site settings"
msgstr "In den Website-Einstellungen ändern"

msgid "No post type selected: comments stay enabled everywhere until you select at least one."
msgstr "Kein Inhaltstyp ausgewählt: Kommentare bleiben überall aktiv, bis Sie mindestens einen auswählen."

msgid "XML-RPC is disabled on this site."
msgstr "XML-RPC ist auf dieser Website deaktiviert."

msgid "Support widget"
msgstr "Support-Widget"

msgid "Show the \"Need help or support?\" widget on the dashboard"
msgstr "Das Widget „Benötigen Sie Hilfe oder Unterstützung?“ im Dashboard anzeigen"

msgid "Contact details of reichelt media.design for all users who can see the dashboard. Each user can still hide it under Screen Options."
msgstr "Kontaktdaten von reichelt media.design für alle Benutzer, die das Dashboard sehen. Jeder Benutzer kann es über „Ansicht anpassen“ ausblenden."

msgid "Need help or support?"
msgstr "Benötigen Sie Hilfe oder Unterstützung?"

msgid "Questions about your website, a change you would like or something is not working? I am happy to help."
msgstr "Sie haben Fragen zu Ihrer Website, wünschen eine Änderung oder etwas funktioniert nicht? Ich helfe Ihnen gern weiter."

msgid "About %s (opens the website in a new tab)"
msgstr "Über %s (öffnet die Website in einem neuen Tab)"

msgid "Write an email"
msgstr "E-Mail schreiben"

msgid "Call"
msgstr "Anrufen"

msgid "Call %s"
msgstr "%s anrufen"

msgid "Menus"
msgstr "Menüs"

msgid "Choose which roles get access to the navigation menus. They find them under \"Menus\" in the admin menu. \"Edit\" opens the WordPress menu screen without access to widgets, the Customizer or theme settings; \"View only\" shows the menus without being able to change them."
msgstr "Legen Sie fest, welche Rollen Zugriff auf die Navigationsmenüs erhalten. Sie finden sie im Adminmenü unter „Menüs“. „Bearbeiten“ öffnet die Menüverwaltung von WordPress ohne Zugriff auf Widgets, den Customizer oder Theme-Einstellungen; „Nur ansehen“ zeigt die Menüs an, ohne dass sie geändert werden können."

msgid "The active theme has no menu locations (for example a block theme). The setting has no effect until a theme with menus is active."
msgstr "Das aktive Theme hat keine Menüpositionen (zum Beispiel ein Block-Theme). Die Einstellung wirkt erst, wenn ein Theme mit Menüs aktiv ist."

msgid "No access"
msgstr "Kein Zugriff"

msgid "View only"
msgstr "Nur ansehen"

msgid "Edit"
msgstr "Bearbeiten"

msgid "Full access (WordPress default)"
msgstr "Voller Zugriff (WordPress-Standard)"

msgid "You can view the menus of this site here. To change them, please contact the administrator."
msgstr "Hier sehen Sie die Menüs dieser Website. Für Änderungen wenden Sie sich bitte an den Administrator."

msgid "Menu locations"
msgstr "Menüpositionen"

msgid "Location"
msgstr "Position"

msgid "Menu"
msgstr "Menü"

msgid "No menu assigned"
msgstr "Kein Menü zugewiesen"

msgid "No menus have been created yet."
msgstr "Es wurden noch keine Menüs angelegt."

msgid "Shown in: %s"
msgstr "Angezeigt in: %s"

msgid "This menu has no items."
msgstr "Dieses Menü hat keine Einträge."

msgid "(no label)"
msgstr "(ohne Beschriftung)"

msgid "Invalid"
msgstr "Ungültig"

msgid "%s user"
msgid_plural "%s users"
msgstr[0] "%s Benutzer"
msgstr[1] "%s Benutzer"

msgid "and %s more"
msgid_plural "and %s more"
msgstr[0] "und %s weiterer"
msgstr[1] "und %s weitere"

msgid "Admin access"
msgstr "Adminzugriff"

msgid "Give roles access to post types and to admin pages of plugins and the theme that they cannot open otherwise. A post type comes with all its permissions (create, edit, publish, delete). An admin page opens with the permissions it needs only on its own screens and when its settings are saved; the rest of the admin area stays as it is."
msgstr "Geben Sie Rollen Zugriff auf Inhaltstypen und Adminseiten von Plugins und Theme, die sie sonst nicht öffnen können. Ein Inhaltstyp wird mit allen Berechtigungen freigegeben (erstellen, bearbeiten, veröffentlichen, löschen). Eine Adminseite erhält die nötigen Berechtigungen nur auf ihren eigenen Bildschirmen und beim Speichern ihrer Einstellungen; der übrige Adminbereich bleibt unverändert."

msgid "Pages that need permissions for users, roles, plugins, themes or updates cannot be shared, and neither can the WordPress settings screens."
msgstr "Seiten, die Berechtigungen für Benutzer, Rollen, Plugins, Themes oder Aktualisierungen benötigen, können nicht freigegeben werden, ebenso wenig die Einstellungsseiten von WordPress."

msgid "There are no post types or admin pages of plugins or the theme."
msgstr "Es gibt keine Inhaltstypen oder Adminseiten von Plugins oder dem Theme."

msgid "Admin pages"
msgstr "Adminseiten"

msgid "uses the permissions of posts"
msgstr "nutzt die Berechtigungen von Beiträgen"

msgid "uses the permissions of pages"
msgstr "nutzt die Berechtigungen von Seiten"

msgid "has access anyway"
msgstr "hat bereits Zugriff"

msgid "not possible: needs protected permissions"
msgstr "nicht möglich: benötigt geschützte Berechtigungen"

msgid "Application passwords"
msgstr "Anwendungspasswörter"

msgid "Application passwords let apps and scripts sign in to the REST API and XML-RPC as a user, without the login form and without two-factor authentication. Switch them off for roles that do not need them: existing application passwords of these roles stop working at once but are not deleted, and the users can no longer create new ones in their profile."
msgstr "Mit Anwendungspasswörtern melden sich Apps und Skripte als Benutzer an der REST-API und an XML-RPC an, ohne Anmeldeformular und ohne Zwei-Faktor-Authentifizierung. Schalten Sie sie für Rollen ab, die sie nicht benötigen: Vorhandene Anwendungspasswörter dieser Rollen funktionieren sofort nicht mehr, werden aber nicht gelöscht, und die Benutzer können in ihrem Profil keine neuen mehr anlegen."

msgid "Users with several roles keep their application passwords as long as one of their roles may use them."
msgstr "Benutzer mit mehreren Rollen behalten ihre Anwendungspasswörter, solange eine ihrer Rollen sie verwenden darf."

msgid "Application passwords are currently not available on this site at all: they need HTTPS, or another plugin has switched them off."
msgstr "Anwendungspasswörter stehen auf dieser Website derzeit generell nicht zur Verfügung: Sie setzen HTTPS voraus, oder ein anderes Plugin hat sie abgeschaltet."

msgid "Disable application passwords"
msgstr "Anwendungspasswörter deaktivieren"

msgid "Existing application passwords"
msgstr "Vorhandene Anwendungspasswörter"

msgid "No user has an application password."
msgstr "Kein Benutzer hat ein Anwendungspasswort."

msgid "User"
msgstr "Benutzer"

msgid "Role"
msgstr "Rolle"

msgid "Name"
msgstr "Name"

msgid "Created"
msgstr "Erstellt"

msgid "Last used"
msgstr "Zuletzt verwendet"

msgid "Status"
msgstr "Status"

msgid "No role"
msgstr "Keine Rolle"

msgid "Never"
msgstr "Nie"

msgid "Disabled"
msgstr "Deaktiviert"

msgid "Active"
msgstr "Aktiv"

msgid "Deleted application passwords cannot be restored. Passwords with the status \"Disabled\" are not accepted at the moment, but would work again as soon as application passwords are enabled."
msgstr "Gelöschte Anwendungspasswörter lassen sich nicht wiederherstellen. Passwörter mit dem Status „Deaktiviert“ werden derzeit nicht akzeptiert, würden aber wieder funktionieren, sobald Anwendungspasswörter aktiviert werden."

msgid "Select all"
msgstr "Alle auswählen"

#. translators: 1: name of the application password, 2: user name
msgid "Select %1$s of %2$s"
msgstr "%1$s von %2$s auswählen"

msgid "Delete selected"
msgstr "Ausgewählte löschen"

msgid "Delete all"
msgstr "Alle löschen"

msgid "Delete the selected application passwords permanently? Applications that use them can no longer sign in."
msgstr "Die ausgewählten Anwendungspasswörter endgültig löschen? Anwendungen, die sie verwenden, können sich dann nicht mehr anmelden."

msgid "Delete all application passwords of all users permanently? Applications that use them can no longer sign in."
msgstr "Alle Anwendungspasswörter aller Benutzer endgültig löschen? Anwendungen, die sie verwenden, können sich dann nicht mehr anmelden."

msgid "%s application password deleted."
msgid_plural "%s application passwords deleted."
msgstr[0] "%s Anwendungspasswort gelöscht."
msgstr[1] "%s Anwendungspasswörter gelöscht."

msgid "Nothing was deleted: select at least one application password."
msgstr "Es wurde nichts gelöscht: Wählen Sie mindestens ein Anwendungspasswort aus."

msgid "Not all application passwords could be deleted. Check the list below."
msgstr "Nicht alle Anwendungspasswörter konnten gelöscht werden. Prüfen Sie die Liste unten."

msgid "Security"
msgstr "Sicherheit"

msgid "XML-RPC is already switched off by a must-use plugin or another plugin. This setting makes no difference as long as that is the case."
msgstr "XML-RPC ist bereits durch ein Must-Use-Plugin oder ein anderes Plugin abgeschaltet. Solange das so ist, macht diese Einstellung keinen Unterschied."

msgid "switched off for the whole site"
msgstr "für die gesamte Website abgeschaltet"

msgid "Updates"
msgstr "Aktualisierungen"

msgid "Installed plugins and themes with their update status. \"Last updated\" is the date of the latest release in the WordPress.org directory: a plugin or theme without a release for more than two years is probably no longer maintained and should be replaced."
msgstr "Installierte Plugins und Themes mit ihrem Aktualisierungsstand. „Zuletzt aktualisiert“ ist das Datum der neuesten Version im WordPress.org-Verzeichnis: Ein Plugin oder Theme ohne neue Version seit mehr als zwei Jahren wird vermutlich nicht mehr gepflegt und sollte ersetzt werden."

msgid "Plugins"
msgstr "Plugins"

msgid "Themes"
msgstr "Themes"

msgid "None installed."
msgstr "Keine installiert."

msgid "Version"
msgstr "Version"

msgid "Update"
msgstr "Aktualisierung"

msgid "Automatic updates"
msgstr "Automatische Aktualisierungen"

msgid "Last updated"
msgstr "Zuletzt aktualisiert"

msgid "inactive"
msgstr "inaktiv"

#. translators: %s: version number
msgid "Update available: %s"
msgstr "Aktualisierung verfügbar: %s"

msgid "Up to date"
msgstr "Aktuell"

msgid "Unknown: no update source"
msgstr "Unbekannt: keine Aktualisierungsquelle"

msgid "On"
msgstr "An"

msgid "Off"
msgstr "Aus"

msgid "Not in the WordPress.org directory"
msgstr "Nicht im WordPress.org-Verzeichnis"

msgid "Not fetched yet"
msgstr "Noch nicht abgerufen"

msgid "Closed in the WordPress.org directory"
msgstr "Im WordPress.org-Verzeichnis geschlossen"

msgid "The colour shows how long ago that release was: up to 30 days green, up to 90 days light green, up to 180 days yellow, up to 365 days orange, older red. It is a rough guide for a quick look, not a verdict: a small plugin can be fine without frequent releases."
msgstr "Die Farbe zeigt, wie lange diese Version her ist: bis 30 Tage grün, bis 90 Tage hellgrün, bis 180 Tage gelb, bis 365 Tage orange, älter rot. Das ist eine grobe Orientierung für den schnellen Blick, kein Urteil: Ein kleines Plugin kann auch ohne häufige neue Versionen in Ordnung sein."

msgid "today"
msgstr "heute"

#. translators: %s: number of days
msgid "%s day ago"
msgid_plural "%s days ago"
msgstr[0] "vor %s Tag"
msgstr[1] "vor %s Tagen"

#. translators: %s: date and time
msgid "WordPress last checked for updates: %s."
msgstr "WordPress hat zuletzt nach Aktualisierungen gesucht: %s."

msgid "WordPress has not checked for updates yet."
msgstr "WordPress hat noch nicht nach Aktualisierungen gesucht."

#. translators: %s: date and time
msgid "Release dates last fetched: %s."
msgstr "Veröffentlichungsdaten zuletzt abgerufen: %s."

msgid "Release dates have not been fetched yet."
msgstr "Die Veröffentlichungsdaten wurden noch nicht abgerufen."

msgid "Fetch release dates from WordPress.org"
msgstr "Veröffentlichungsdaten von WordPress.org abrufen"

msgid "Open the WordPress updates screen"
msgstr "WordPress-Aktualisierungen öffnen"

msgid "Release dates fetched from WordPress.org."
msgstr "Veröffentlichungsdaten von WordPress.org abgerufen."

msgid "Not all release dates could be fetched from WordPress.org. Please try again later."
msgstr "Nicht alle Veröffentlichungsdaten konnten von WordPress.org abgerufen werden. Bitte versuchen Sie es später erneut."
