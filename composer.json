{
  "name": "reicheltmediadesign/wordpress-rmd-site-settings",
  "description": "Basic WordPress site settings: disable comments, XML-RPC, wp_head clean-up and dashboard tidy-up.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Philipp Reichelt",
      "email": "info@reicheltmedia.design",
      "homepage": "https://reicheltmedia.design"
    }
  ],
  "require": {
    "php": ">=8.1",
    "yahnis-elsts/plugin-update-checker": "^5.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.8"
  },
  "autoload": {
    "psr-4": {
      "RMD\\SiteSettings\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RMD\\SiteSettings\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.1.0"
    }
  },
  "scripts": {
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "test": "phpunit"
  }
}
